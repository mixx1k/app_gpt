{
  "name": "mlynek-pos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "db:backup": "node scripts/backup.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:install": "install-electron",
    "desktop": "npm run build && node scripts/start-desktop.mjs",
    "desktop:start": "node scripts/start-desktop.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux dir --x64",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "desktop:icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "description": "Młynek POS — aplikacja desktopowa dla kawiarni",
  "author": "Młynek POS",
  "license": "UNLICENSED",
  "main": "desktop/main.mjs"
}
